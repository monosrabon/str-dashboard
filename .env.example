# AURA STR Enterprise Management System
# Environment Configuration Template

# Database Connection (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:5432/str_manager?schema=public"

# NextAuth Secret & Base URL
NEXTAUTH_SECRET="your-production-secret-key-32-chars-minimum"
NEXTAUTH_URL="http://localhost:3000"

# AI / Large Language Model API (Optional - OpenAI or Google Gemini)
OPENAI_API_KEY=""
# GOOGLE_GEMINI_API_KEY=""

# Email Dispatcher (Optional - SendGrid / Resend)
# RESEND_API_KEY=""
